// Skema database SI-AMI ITBMP
// 4 Role: SUPER_ADMIN, LPM, AUDITOR, AUDITEE
// 3 Prodi: Bisnis Digital, Aktuaria, Perancangan Wilayah dan Kota

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  LPM
  AUDITOR
  AUDITEE
}

enum Tahap {
  PERSIAPAN
  PENGISIAN
  AUDIT_DOKUMEN
  AUDIT_LAPANGAN
  KALIBRASI_CLOSING
  PELAPORAN_RTL
  SELESAI
}

enum StatusDokumen {
  BELUM_DICEK
  LENGKAP
  PERLU_KLARIFIKASI
}

enum Klasifikasi {
  MELAMPAUI
  MENCAPAI
  OBSERVASI
  KTS_MINOR
  KTS_MAYOR
}

enum StatusRtl {
  BELUM
  PROSES
  SELESAI_AUDITEE
  TERVERIFIKASI
}

enum PeranTim {
  KETUA
  ANGGOTA
}

model Unit {
  id        String      @id @default(cuid())
  kode      String      @unique
  nama      String
  jenis     String      @default("PRODI")
  diaudit   Boolean     @default(true)
  createdAt DateTime    @default(now())
  users     User[]
  periode   Periode[]
  penugasan Penugasan[]
  isian     Isian[]
}

model User {
  id                String             @id @default(cuid())
  nama              String
  nimNuptk          String             @default("")
  username          String             @unique
  passwordHash      String
  /// Salinan password terenkripsi AES-256-GCM agar Super Admin bisa melihatnya.
  passwordEnc       String
  role              Role
  unitId            String?
  unit              Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  isTraining        Boolean            @default(false)
  trainingPeriodeId String?
  trainingPeriode   Periode?           @relation("TrainingUsers", fields: [trainingPeriodeId], references: [id], onDelete: SetNull)
  aktif             Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tim               PenugasanAuditor[]
  logs              AuditLog[]
}

model Periode {
  id                String      @id @default(cuid())
  nama              String
  tahun             String
  semester          String      @default("Ganjil")
  isTraining        Boolean     @default(false)
  unitId            String?
  unit              Unit?       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tahap             Tahap       @default(PENGISIAN)
  sourceLocked      Boolean     @default(false)
  aktif             Boolean     @default(true)
  tglMulaiPengisian DateTime?
  tglCutOff         DateTime?
  tglOpening        DateTime?
  tglClosing        DateTime?
  disahkanAt        DateTime?
  disahkanOleh      String?
  ketuaAuditeeId    String?
  ketuaAuditeeNama  String?
  ketuaAuditeeNip   String?
  ttdAuditee        String?
  ttdAuditeeAt      DateTime?
  ketuaAuditorId    String?
  ketuaAuditorNama  String?
  ketuaAuditorNip   String?
  ttdAuditor        String?
  ttdAuditorAt      DateTime?
  kepalaLpmNama     String?
  kepalaLpmNip      String?
  ttdLpm            String?
  ttdLpmAt          DateTime?
  createdAt         DateTime    @default(now())
  indikator         Indikator[]
  penugasan         Penugasan[]
  trainingUsers     User[]      @relation("TrainingUsers")
}

model Indikator {
  id                String  @id @default(cuid())
  periodeId         String
  periode           Periode @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  kode              String
  standar           String
  pernyataanStandar String?
  pernyataan        String
  target            String  @default("-")
  buktiDiminta      String?
  urutan            Int     @default(0)
  isian             Isian[]

  @@unique([periodeId, standar, kode])
}

model Penugasan {
  id                    String             @id @default(cuid())
  periodeId             String
  periode               Periode            @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  unitId                String
  unit                  Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  jadwalDokumenMulai    DateTime?
  jadwalDokumenSelesai  DateTime?
  jadwalLapanganMulai   DateTime?
  jadwalLapanganSelesai DateTime?
  disahkan              Boolean            @default(false)
  alasanPerubahan       String?
  sumber                String             @default("MANUAL")
  updatedAt             DateTime           @updatedAt
  tim                   PenugasanAuditor[]

  @@unique([periodeId, unitId])
}

model PenugasanAuditor {
  id          String    @id @default(cuid())
  penugasanId String
  penugasan   Penugasan @relation(fields: [penugasanId], references: [id], onDelete: Cascade)
  auditorId   String
  auditor     User      @relation(fields: [auditorId], references: [id], onDelete: Cascade)
  peran       PeranTim

  @@unique([penugasanId, auditorId])
}

model Isian {
  id                   String        @id @default(cuid())
  indikatorId          String
  indikator            Indikator     @relation(fields: [indikatorId], references: [id], onDelete: Cascade)
  unitId               String
  unit                 Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  klaim                String?
  linkDrive            String?
  diisiOleh            String?
  statusDokumen        StatusDokumen @default(BELUM_DICEK)
  catatanDokumen       String?
  catatanLapangan      String?
  klasifikasi          Klasifikasi?
  rekomendasi          String?
  diperiksaOleh         String?
  terverifikasiAuditor  Boolean       @default(false)
  terverifikasiLapangan Boolean       @default(false)
  rtlRencana            String?
  rtlLinkBukti         String?
  rtlStatus            StatusRtl     @default(BELUM)
  rtlCatatanAuditor    String?
  updatedAt            DateTime      @updatedAt

  @@unique([indikatorId, unitId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aksi      String
  detail    String?
  createdAt DateTime @default(now())
}
