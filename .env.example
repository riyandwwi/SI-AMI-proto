# Jika provider Anda tidak membedakan, isi keduanya dengan nilai yang sama.
DATABASE_URL="postgresql://user:password@host:5432/ami_itbmp?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/ami_itbmp?sslmode=require"

# Rahasia penandatangan sesi login (string acak panjang, min. 32 karakter).
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# Kunci enkripsi salinan password yang bisa dilihat Super Admin.
# JANGAN diganti setelah ada akun, atau password lama tidak bisa dibaca lagi.
PASSWORD_ENC_KEY="ganti-dengan-string-acak-lain-minimal-32-karakter"
